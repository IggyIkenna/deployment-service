# alerting-service — live mode protocol config

SERVICE_MODE=live

# Data sink — persists alert records for audit / replay
PROTOCOL_DATA_SINK_BACKEND=gcs
PROTOCOL_DATA_SINK_BUCKET=uts-prod-alerting
PROTOCOL_DATA_SINK_PATH_PREFIX=alerts
PROTOCOL_DATA_SINK_FORMAT=parquet

# Event bus — subscribes to system health and trading events
PROTOCOL_EVENT_BUS_BACKEND=pubsub
PROTOCOL_EVENT_BUS_TOPIC_PREFIX=alerting
PROTOCOL_EVENT_BUS_PROJECT=${GCP_PROJECT_ID}

PROTOCOL_CONFIG_STORE_BACKEND=secretmanager
