# risk-and-exposure-service — live mode protocol config

SERVICE_MODE=live

# Data source — reads positions and execution data
PROTOCOL_DATA_SOURCE_BACKEND=gcs
PROTOCOL_DATA_SOURCE_BUCKET=uts-prod-execution

# Data sink — writes risk reports and exposure snapshots
PROTOCOL_DATA_SINK_BACKEND=gcs
PROTOCOL_DATA_SINK_BUCKET=uts-prod-risk
PROTOCOL_DATA_SINK_PATH_PREFIX=risk/live
PROTOCOL_DATA_SINK_FORMAT=parquet

# Event bus — publishes risk.breach and risk.warning events
PROTOCOL_EVENT_BUS_BACKEND=pubsub
PROTOCOL_EVENT_BUS_TOPIC_PREFIX=risk
PROTOCOL_EVENT_BUS_PROJECT=${GCP_PROJECT_ID}

PROTOCOL_CONFIG_STORE_BACKEND=secretmanager
