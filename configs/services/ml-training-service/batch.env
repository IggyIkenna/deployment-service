# ml-training-service — batch mode protocol config

SERVICE_MODE=batch

# Data source — reads features from features store
PROTOCOL_DATA_SOURCE_BACKEND=gcs
PROTOCOL_DATA_SOURCE_BUCKET=uts-prod-features

# Data sink — writes trained model artifacts to models store
PROTOCOL_DATA_SINK_BACKEND=gcs
PROTOCOL_DATA_SINK_BUCKET=uts-prod-models
PROTOCOL_DATA_SINK_PATH_PREFIX=models
PROTOCOL_DATA_SINK_FORMAT=json

# Analytics — BigQuery for feature queries and experiment tracking
PROTOCOL_ANALYTICS_BACKEND=bigquery
PROTOCOL_ANALYTICS_PROJECT=${GCP_PROJECT_ID}
PROTOCOL_ANALYTICS_DATASET=features_data

PROTOCOL_EVENT_BUS_BACKEND=local

PROTOCOL_CONFIG_STORE_BACKEND=secretmanager
