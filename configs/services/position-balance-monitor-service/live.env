# position-balance-monitor-service — live mode protocol config

SERVICE_MODE=live

PROTOCOL_DATA_SINK_BACKEND=gcs
PROTOCOL_DATA_SINK_BUCKET=uts-prod-positions
PROTOCOL_DATA_SINK_PATH_PREFIX=positions
PROTOCOL_DATA_SINK_FORMAT=parquet

PROTOCOL_EVENT_BUS_BACKEND=pubsub
PROTOCOL_EVENT_BUS_TOPIC_PREFIX=positions
PROTOCOL_EVENT_BUS_PROJECT=${GCP_PROJECT_ID}

PROTOCOL_CONFIG_STORE_BACKEND=secretmanager
