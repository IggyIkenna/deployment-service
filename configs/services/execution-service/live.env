# execution-service — live mode protocol config

SERVICE_MODE=live

# Data sink — trade records / backtest results (single bucket, no category split)
PROTOCOL_DATA_SINK_BACKEND=gcs
PROTOCOL_DATA_SINK_BUCKET=uts-prod-execution
PROTOCOL_DATA_SINK_PATH_PREFIX=trades
PROTOCOL_DATA_SINK_FORMAT=parquet

# Data source — reads strategy signals and instrument definitions
PROTOCOL_DATA_SOURCE_BACKEND=gcs
PROTOCOL_DATA_SOURCE_BUCKET=uts-prod-strategy

# Event bus — publishes execution.filled / execution.rejected events
PROTOCOL_EVENT_BUS_BACKEND=pubsub
PROTOCOL_EVENT_BUS_TOPIC_PREFIX=execution
PROTOCOL_EVENT_BUS_PROJECT=${GCP_PROJECT_ID}

PROTOCOL_CONFIG_STORE_BACKEND=secretmanager
