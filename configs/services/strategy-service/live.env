# strategy-service — live mode protocol config

SERVICE_MODE=live

PROTOCOL_DATA_SOURCE_BACKEND=gcs
PROTOCOL_DATA_SOURCE_BUCKET=uts-prod-features

PROTOCOL_DATA_SINK_BACKEND=gcs
PROTOCOL_DATA_SINK_BUCKET=uts-prod-strategy
PROTOCOL_DATA_SINK_PATH_PREFIX=signals/live
PROTOCOL_DATA_SINK_FORMAT=parquet

PROTOCOL_EVENT_BUS_BACKEND=pubsub
PROTOCOL_EVENT_BUS_TOPIC_PREFIX=strategy
PROTOCOL_EVENT_BUS_PROJECT=${GCP_PROJECT_ID}

PROTOCOL_CONFIG_STORE_BACKEND=secretmanager
