# instruments-service — batch mode protocol config
# Injected by deployment bootstrap into Cloud Run / ECS task at deploy time.
# All defaults here are for GCP. For AWS, swap gcs→s3 and update bucket names.
# For local dev / CI: leave PROTOCOL_DATA_SINK_BACKEND=local (default) — no credentials needed.

SERVICE_MODE=batch

# Data sink — where instrument parquet files are written (partitioned by category)
PROTOCOL_DATA_SINK_BACKEND=gcs
PROTOCOL_DATA_SINK_BUCKET_CEFI=uts-prod-instruments-cefi
PROTOCOL_DATA_SINK_BUCKET_TRADFI=uts-prod-instruments-tradfi
PROTOCOL_DATA_SINK_BUCKET_DEFI=uts-prod-instruments-defi
PROTOCOL_DATA_SINK_PATH_PREFIX=instrument_availability/by_date
PROTOCOL_DATA_SINK_FORMAT=parquet

# Event bus — publishes instruments.updated event after each run
PROTOCOL_EVENT_BUS_BACKEND=pubsub
PROTOCOL_EVENT_BUS_TOPIC_PREFIX=instruments
PROTOCOL_EVENT_BUS_PROJECT=${GCP_PROJECT_ID}

# Config / secrets
PROTOCOL_CONFIG_STORE_BACKEND=secretmanager
