# market-data-processing-service — batch mode protocol config

SERVICE_MODE=batch

# Data source — reads raw tick data from upstream market-data buckets
PROTOCOL_DATA_SOURCE_BACKEND=gcs
PROTOCOL_DATA_SOURCE_BUCKET_CEFI=uts-prod-market-data-cefi
PROTOCOL_DATA_SOURCE_BUCKET_TRADFI=uts-prod-market-data-tradfi
PROTOCOL_DATA_SOURCE_BUCKET_DEFI=uts-prod-market-data-defi

# Data sink — writes processed candles / normalised data to same buckets (or separate)
PROTOCOL_DATA_SINK_BACKEND=gcs
PROTOCOL_DATA_SINK_BUCKET_CEFI=uts-prod-market-data-cefi
PROTOCOL_DATA_SINK_BUCKET_TRADFI=uts-prod-market-data-tradfi
PROTOCOL_DATA_SINK_BUCKET_DEFI=uts-prod-market-data-defi
PROTOCOL_DATA_SINK_PATH_PREFIX=candles
PROTOCOL_DATA_SINK_FORMAT=parquet

PROTOCOL_EVENT_BUS_BACKEND=pubsub
PROTOCOL_EVENT_BUS_TOPIC_PREFIX=market_data_processing
PROTOCOL_EVENT_BUS_PROJECT=${GCP_PROJECT_ID}

PROTOCOL_CONFIG_STORE_BACKEND=secretmanager
