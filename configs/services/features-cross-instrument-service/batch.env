# features-cross-instrument-service — batch mode protocol config

SERVICE_MODE=batch

PROTOCOL_DATA_SINK_BACKEND=gcs
PROTOCOL_DATA_SINK_BUCKET=uts-prod-features-cross-instrument
PROTOCOL_DATA_SINK_PATH_PREFIX=by_date
PROTOCOL_DATA_SINK_FORMAT=parquet

PROTOCOL_DATA_SOURCE_BACKEND=gcs
PROTOCOL_DATA_SOURCE_BUCKET=uts-prod-features-volatility-cefi

PROTOCOL_EVENT_BUS_BACKEND=pubsub
PROTOCOL_EVENT_BUS_TOPIC_PREFIX=features_cross_instrument
PROTOCOL_EVENT_BUS_PROJECT=${GCP_PROJECT_ID}

PROTOCOL_CONFIG_STORE_BACKEND=secretmanager
