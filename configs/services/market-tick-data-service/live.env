# market-tick-data-service — live mode protocol config

SERVICE_MODE=live

# Data sink — raw tick data written per category
PROTOCOL_DATA_SINK_BACKEND=gcs
PROTOCOL_DATA_SINK_BUCKET_CEFI=uts-prod-market-data-cefi
PROTOCOL_DATA_SINK_BUCKET_TRADFI=uts-prod-market-data-tradfi
PROTOCOL_DATA_SINK_BUCKET_DEFI=uts-prod-market-data-defi
PROTOCOL_DATA_SINK_PATH_PREFIX=tick_data/raw
PROTOCOL_DATA_SINK_FORMAT=parquet

# Event bus — publishes tick_data.received after each batch flush
PROTOCOL_EVENT_BUS_BACKEND=pubsub
PROTOCOL_EVENT_BUS_TOPIC_PREFIX=market_tick_data
PROTOCOL_EVENT_BUS_PROJECT=${GCP_PROJECT_ID}

PROTOCOL_CONFIG_STORE_BACKEND=secretmanager
