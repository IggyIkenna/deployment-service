# ml-inference-service — live mode protocol config

SERVICE_MODE=live

# Data source — reads model artifacts from models store
PROTOCOL_DATA_SOURCE_BACKEND=gcs
PROTOCOL_DATA_SOURCE_BUCKET=uts-prod-models

# Event bus — publishes ml_predictions.generated events
PROTOCOL_EVENT_BUS_BACKEND=pubsub
PROTOCOL_EVENT_BUS_TOPIC_PREFIX=ml_predictions
PROTOCOL_EVENT_BUS_PROJECT=${GCP_PROJECT_ID}

PROTOCOL_CONFIG_STORE_BACKEND=secretmanager
