# Example terraform.tfvars for features-multi-timeframe-service on AWS
# Copy to terraform.tfvars and fill in your values

# AWS Region
region = "ap-northeast-1"

# Job Configuration
job_name     = "features-multi-timeframe-service"
docker_image = "123456789012.dkr.ecr.ap-northeast-1.amazonaws.com/features-multi-timeframe-service:latest"

vcpus           = "4"
memory_mb       = "8192"
timeout_seconds = 7200
max_retries     = 3
environment     = "prod"

# IAM Roles (from shared-infrastructure module)
execution_role_arn = "arn:aws:iam::123456789012:role/trading-execution-role"
job_role_arn       = "arn:aws:iam::123456789012:role/trading-job-role"

# Networking (from shared-infrastructure module)
subnet_ids         = ["subnet-abc123", "subnet-def456"]
security_group_ids = ["sg-abc123"]
job_queue_arn      = "arn:aws:batch:ap-northeast-1:123456789012:job-queue/trading-queue"

# S3 Buckets - Input (delta-one features — upstream dependency)
s3_bucket_delta_one_cefi   = "features-delta-one-cefi"
s3_bucket_delta_one_tradfi = "features-delta-one-tradfi"
s3_bucket_delta_one_defi   = "features-delta-one-defi"

# S3 Buckets - Output (multi-timeframe features)
features_bucket_cefi   = "features-multi-timeframe-cefi"
features_bucket_tradfi = "features-multi-timeframe-tradfi"
features_bucket_defi   = "features-multi-timeframe-defi"

# Workflow Configuration
workflow_name = "features-multi-timeframe-service-daily"

# Scheduler Configuration
schedule  = "0 12 * * *"  # 12:00 PM UTC daily (after features-delta-one at 10:30 AM)
time_zone = "UTC"
