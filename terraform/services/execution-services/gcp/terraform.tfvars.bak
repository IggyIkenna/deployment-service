# Terraform variables for execution-services

project_id   = "central-element-323112"
region       = "asia-northeast1"
gcs_location = "asia-northeast1"
environment  = "prod"

job_name     = "execution-services-job"
docker_image = "asia-northeast1-docker.pkg.dev/central-element-323112/execution-services/execution-services:latest"

service_account_email           = "execution-services-sa@central-element-323112.iam.gserviceaccount.com"
scheduler_service_account_email = "execution-services-sa@central-element-323112.iam.gserviceaccount.com"

# Heavy tick-by-tick simulation workload
cpu             = "4"
memory          = "16Gi"
timeout_seconds = 14400  # 4 hours
max_retries     = 2

execution_bucket_cefi   = "execution-store-cefi-central-element-323112"
execution_bucket_tradfi = "execution-store-tradfi-central-element-323112"
execution_bucket_defi   = "execution-store-defi-central-element-323112"

workflow_name          = "execution-services-daily"
backfill_workflow_name = "execution-services-backtest"

# Schedule at 16:00 PM UTC (after strategy)
schedule  = "0 16 * * *"
time_zone = "UTC"
