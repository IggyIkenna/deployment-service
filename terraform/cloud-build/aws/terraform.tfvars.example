# Terraform variables for AWS CodeBuild
# Copy this file to terraform.tfvars and customize

region       = "ap-northeast-1"
environment  = "prod"
github_owner = "IggyIkenna"

# Compute size and build branch are per-service (see locals.services in main.tf), not variables:
# the two heavy base builds (unified-trading-library, market-tick-data-service) run
# BUILD_GENERAL1_LARGE on aws/codebuild/standard:7.0; everything else runs
# BUILD_GENERAL1_MEDIUM on aws/codebuild/amazonlinux2-x86_64-standard:5.0.
