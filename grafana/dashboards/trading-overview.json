{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "Odum Trading Overview",
  "uid": "odum-trading-overview",
  "version": 1,
  "schemaVersion": 39,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Circuit Breaker State",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "circuit_breaker_state",
          "legendFormat": "{{strategy_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"options": {"0": {"text": "CLOSED", "color": "green"}}, "type": "value"},
            {"options": {"1": {"text": "HALF-OPEN", "color": "yellow"}}, "type": "value"},
            {"options": {"2": {"text": "OPEN", "color": "red"}}, "type": "value"}
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Trade Execution Latency (P95)",
      "gridPos": {"x": 4, "y": 0, "w": 10, "h": 8},
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "histogram_quantile(0.95, rate(trade_execution_latency_seconds_bucket[5m]))",
          "legendFormat": "P95 {{venue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 0.1, "color": "yellow"},
              {"value": 0.5, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Reconciliation Drift (USD)",
      "gridPos": {"x": 14, "y": 0, "w": 5, "h": 4},
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "reconciliation_drift_usd",
          "legendFormat": "{{venue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 100, "color": "yellow"},
              {"value": 500, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Position Notional (USD)",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "position_notional_usd",
          "legendFormat": "{{strategy_id}} {{instrument_key}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "PnL Drawdown %",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "pnl_drawdown_pct * 100",
          "legendFormat": "{{strategy_id}} {{client_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {"value": -100, "color": "red"},
              {"value": -5, "color": "yellow"},
              {"value": 0, "color": "green"}
            ]
          }
        }
      }
    }
  ]
}